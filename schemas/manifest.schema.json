{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "agents": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "sha256",
          "source"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "config": {},
    "cost": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "additionalProperties": false,
          "properties": {
            "candidates": {
              "description": "Candidate findings sent to validation.",
              "type": "integer"
            },
            "executions": {
              "description": "Agent executions, every attempt included.",
              "type": "integer"
            },
            "pruv_executions": {
              "type": "integer"
            },
            "reported_executions": {
              "description": "Executions that reported a non-zero cost.",
              "type": "integer"
            },
            "usd": {
              "description": "Sum of the cost every execution reported; executions that reported none add nothing.",
              "type": "number"
            }
          },
          "required": [
            "usd",
            "executions",
            "reported_executions",
            "pruv_executions",
            "candidates"
          ],
          "type": "object"
        },
        "approval": {
          "enum": [
            "yes_flag",
            "prompt",
            "within_budget",
            "no_budget",
            "unchecked"
          ],
          "type": "string"
        },
        "budget_usd": {
          "description": "Whole-run budget (cost.budget_usd); 0 means no budget.",
          "type": "number"
        },
        "estimate": {
          "additionalProperties": false,
          "properties": {
            "discovery_usd": {
              "type": "number"
            },
            "files": {
              "description": "Snapshot files the reviewers read.",
              "type": "integer"
            },
            "harness_enforces_budget": {
              "description": "Whether each term was capped at the per-execution agents.max_budget_usd.",
              "type": "boolean"
            },
            "high_usd": {
              "type": "number"
            },
            "kind": {
              "description": "What was estimated: audit, verify, or total.",
              "type": "string"
            },
            "low_usd": {
              "type": "number"
            },
            "model": {
              "description": "Cost model version.",
              "type": "string"
            },
            "pruv_calls_high": {
              "type": "integer"
            },
            "pruv_calls_low": {
              "type": "integer"
            },
            "pruv_high_usd": {
              "type": "number"
            },
            "pruv_low_usd": {
              "type": "number"
            },
            "rates": {
              "additionalProperties": false,
              "properties": {
                "discovery_usd": {
                  "description": "One discovery execution.",
                  "type": "number"
                },
                "file_review_usd": {
                  "description": "One reviewer execution, per snapshot file.",
                  "type": "number"
                },
                "pruv_call_usd": {
                  "description": "One Pruv execution.",
                  "type": "number"
                }
              },
              "required": [
                "discovery_usd",
                "file_review_usd",
                "pruv_call_usd"
              ],
              "type": "object"
            },
            "reviewers": {
              "type": "integer"
            },
            "reviewers_usd": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "model",
            "files",
            "reviewers",
            "pruv_calls_low",
            "pruv_calls_high",
            "rates",
            "harness_enforces_budget",
            "discovery_usd",
            "reviewers_usd",
            "pruv_low_usd",
            "pruv_high_usd",
            "low_usd",
            "high_usd"
          ],
          "type": "object"
        }
      },
      "required": [
        "estimate",
        "budget_usd",
        "approval",
        "actual"
      ],
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "type": "string"
    },
    "harness": {
      "additionalProperties": false,
      "properties": {
        "binary": {
          "type": "string"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "model": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "binary",
        "version",
        "capabilities"
      ],
      "type": "object"
    },
    "host": {
      "type": "string"
    },
    "integrity": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "type": "string"
        },
        "repository_unchanged": {
          "type": "boolean"
        }
      },
      "required": [
        "repository_unchanged",
        "detail"
      ],
      "type": "object"
    },
    "kind": {
      "type": "string"
    },
    "pid": {
      "type": "integer"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "command_execution": {
          "type": "boolean"
        },
        "enforcement": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "network": {
          "type": "boolean"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "unenforced": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "tools",
        "command_execution",
        "network",
        "enforcement",
        "unenforced"
      ],
      "type": "object"
    },
    "repository": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "diff_sha256": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        },
        "dirty_policy": {
          "enum": [
            "refuse",
            "head",
            "include"
          ],
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "skipped_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "snapshot_digest": {
          "type": "string"
        },
        "snapshot_files": {
          "type": "integer"
        },
        "source_revision": {
          "type": "string"
        },
        "status_porcelain": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "path",
        "commit",
        "dirty",
        "dirty_policy",
        "source_revision",
        "snapshot_digest",
        "snapshot_files"
      ],
      "type": "object"
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer"
    },
    "sift_version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "partial",
        "failed",
        "interrupted"
      ],
      "type": "string"
    },
    "tasks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifacts": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "depends_on": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ended_at": {
            "format": "date-time",
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "executions": {
            "description": "Run-relative paths of execution results.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed",
              "skipped",
              "interrupted"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    },
    "verifies": {
      "additionalProperties": false,
      "properties": {
        "findings": {
          "description": "IDs of the findings verified, sorted and unique.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "findings_sha256": {
          "description": "SHA-256 of the original run's artifacts/findings.json.",
          "type": "string"
        },
        "run": {
          "description": "ID of the audit run being verified.",
          "type": "string"
        },
        "snapshot_digest": {
          "description": "The original run's repository.snapshot_digest.",
          "type": "string"
        },
        "source_revision": {
          "description": "The original run's repository.source_revision.",
          "type": "string"
        }
      },
      "required": [
        "run",
        "source_revision",
        "snapshot_digest",
        "findings",
        "findings_sha256"
      ],
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "run_id",
    "sift_version",
    "status",
    "created_at",
    "updated_at",
    "pid",
    "host",
    "repository",
    "config",
    "harness",
    "agents",
    "policy",
    "tasks"
  ],
  "title": "Sift audit manifest",
  "type": "object"
}
