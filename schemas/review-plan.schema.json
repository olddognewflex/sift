{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string"
    },
    "max_findings_per_reviewer": {
      "type": "integer"
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer"
    },
    "tasks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "agent": {
            "type": "string"
          },
          "category": {
            "enum": [
              "architecture",
              "correctness"
            ],
            "type": "string"
          },
          "focus": {
            "description": "Critical paths and modules highlighted by discovery.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "agent",
          "category",
          "focus"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "run_id",
    "tasks",
    "max_findings_per_reviewer"
  ],
  "title": "Sift review plan",
  "type": "object"
}
