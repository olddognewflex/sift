{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "alternatives": {
            "description": "Other options and their trade-offs.",
            "type": "string"
          },
          "category": {
            "enum": [
              "architecture",
              "correctness"
            ],
            "type": "string"
          },
          "claim": {
            "description": "Precise, falsifiable statement of the problem.",
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "type": "string"
          },
          "evidence": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "command": {
                  "description": "Execution evidence: the exact command run.",
                  "type": "string"
                },
                "description": {
                  "description": "What this evidence shows and why it supports the claim.",
                  "type": "string"
                },
                "end_line": {
                  "description": "Source evidence: last cited line, inclusive.",
                  "type": "integer"
                },
                "environment": {
                  "description": "Execution evidence: relevant environment.",
                  "type": "string"
                },
                "excerpt": {
                  "description": "Source evidence: the cited lines copied verbatim from the file.",
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "source",
                    "execution"
                  ],
                  "type": "string"
                },
                "limitations": {
                  "description": "What this evidence does not establish.",
                  "type": "string"
                },
                "path": {
                  "description": "Source evidence: file path relative to the repository root.",
                  "type": "string"
                },
                "result": {
                  "description": "Execution evidence: observed result.",
                  "type": "string"
                },
                "start_line": {
                  "description": "Source evidence: first cited line, 1-based.",
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "description"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "evidence_checks": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "actual_end_line": {
                  "type": "integer"
                },
                "actual_start_line": {
                  "type": "integer"
                },
                "detail": {
                  "type": "string"
                },
                "index": {
                  "type": "integer"
                },
                "status": {
                  "enum": [
                    "verified",
                    "relocated",
                    "mismatch",
                    "missing_file",
                    "invalid_range",
                    "not_verifiable"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "index",
                "status",
                "detail"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "expected_impact": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "location_checks": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "actual_end_line": {
                  "type": "integer"
                },
                "actual_start_line": {
                  "type": "integer"
                },
                "detail": {
                  "type": "string"
                },
                "index": {
                  "type": "integer"
                },
                "status": {
                  "enum": [
                    "verified",
                    "relocated",
                    "mismatch",
                    "missing_file",
                    "invalid_range",
                    "not_verifiable"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "index",
                "status",
                "detail"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "locations": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "end_line": {
                  "description": "Last line, inclusive.",
                  "type": "integer"
                },
                "path": {
                  "description": "Path relative to the repository root, using forward slashes.",
                  "type": "string"
                },
                "start_line": {
                  "description": "First line, 1-based.",
                  "type": "integer"
                }
              },
              "required": [
                "path",
                "start_line",
                "end_line"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "remediation": {
            "type": "string"
          },
          "reported_by": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ],
            "type": "string"
          },
          "source_revision": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "triggering_conditions": {
            "description": "Concrete conditions under which the problem manifests.",
            "type": "string"
          },
          "validation_state": {
            "enum": [
              "candidate",
              "confirmed",
              "supported_risk",
              "rejected",
              "needs_investigation",
              "unvalidated"
            ],
            "type": "string"
          },
          "validation_state_reason": {
            "type": "string"
          },
          "verification_criteria": {
            "description": "How to verify that remediation worked.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source_revision",
          "category",
          "reported_by",
          "title",
          "claim",
          "locations",
          "evidence",
          "triggering_conditions",
          "expected_impact",
          "severity",
          "confidence",
          "remediation",
          "verification_criteria",
          "evidence_checks",
          "validation_state"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "kind": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "run_id",
    "findings"
  ],
  "title": "Sift findings",
  "type": "object"
}
